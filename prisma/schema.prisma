datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model SystemSetting {
  id                  String   @id @default(cuid())
  defaultInterval     Int      @default(3)
  emailNotifications  Boolean  @default(true)
  autoBackup          Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Fixture {
  id         String @id @default(uuid())

  fixtureId  String @unique
  serialNo   String
  name       String
  owner      String
  project    String
  status     String

  dueDate    DateTime

  createdBy  String?
  updatedBy  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  user       String
  action     String
  fixtureId  String
  details    String
  ipAddress  String?

  createdAt  DateTime @default(now())
}

model User {
  id          String   @id @default(cuid())

  username    String
  email       String   @unique
  password    String

  role        String   @default("USER")
  isApproved  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}