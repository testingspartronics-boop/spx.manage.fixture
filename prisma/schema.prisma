datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemSetting {
  id                  String   @id @default(cuid())
  defaultInterval     Int      @default(3)
  emailNotifications  Boolean  @default(true)
  autoBackup          Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@map("SPX_Fixture_SystemSetting")
}

model Fixture {
  id         String @id @default(uuid())

  fixtureId  String @unique
  serialNo   String
  name       String
  owner      String
  project    String
  status     String

  dueDate    DateTime

  createdBy  String?
  updatedBy  String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("SPX_Fixture")
}

model Project {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  devices     ProjectDevice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("SPX_Project")
}

model Device {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  customerName      String?
  serialNumber      String?
  assetType         String          @default("DEVICE")
  category          String
  fgCode            String?
  quantity          Int             @default(1)
  availableQuantity Int             @default(1)
  status            String          @default("ACTIVE")
  location          String?
  notes             String?
  projects          ProjectDevice[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("SPX_Device")
}

model ProjectDevice {
  projectId String
  deviceId  String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  device    Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, deviceId])
  @@map("SPX_ProjectDevice")
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  user       String
  action     String
  fixtureId  String
  details    String
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@map("SPX_Fixture_AuditLog")
}

model User {
  id          Int      @id @default(autoincrement())

  username    String
  email       String   @unique
  password    String

  role        String   @default("USER")
  isApproved  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("SPX_Fixture_User")
}